// ==================== GET STOCK LEVELS WITH RESERVATIONS ====================
function getStockLevelsWithReservations() {
  try {
    const ss = SpreadsheetApp.openById(SHEET_ID);
    const sheet = ss.getSheetByName(SHEET_NAME);
    const reservationsSheet = ss.getSheetByName('Reservations');
    
    if (!sheet) return {};
    
    const lastRow = sheet.getLastRow();
    if (lastRow < 2) return {};
    
    const stockData = sheet.getRange('A2:C' + lastRow).getValues();
    const stockByCategory = {};
    
    // Build reservation totals map
    let reservationTotals = {};
    if (reservationsSheet) {
      const resLastRow = reservationsSheet.getLastRow();
      if (resLastRow >= 2) {
        const resData = reservationsSheet.getRange('A2:E' + resLastRow).getValues();
        for (let i = 0; i < resData.length; i++) {
          const category = resData[i][0];
          const itemName = resData[i][1];
          const qty = resData[i][3];
          
          if (category && itemName && typeof qty === 'number') {
            const key = `${category}|${itemName}`;
            if (!reservationTotals[key]) {
              reservationTotals[key] = 0;
            }
            reservationTotals[key] += qty;
          }
        }
      }
    }
    
    // Process stock data
    for (let i = 0; i < stockData.length; i++) {
      const category = stockData[i][0];
      const itemName = stockData[i][1];
      let quantity = stockData[i][2];
      
      if (!category || !itemName) continue;
      
      if (typeof quantity !== 'number') {
        quantity = parseInt(quantity) || 0;
      }
      
      const key = `${category}|${itemName}`;
      const reserved = reservationTotals[key] || 0;
      const remaining = quantity - reserved;
      
      if (!stockByCategory[category]) {
        stockByCategory[category] = [];
      }
      
      let status = 'Good';
      if (remaining === 0) {
        status = 'Out of Stock';
      } else if (remaining < 10) {
        status = 'Low Stock';
      } else if (remaining < 50) {
        status = 'Medium Stock';
      }
      
      stockByCategory[category].push({
        name: itemName,
        quantity: quantity,
        reserved: reserved,
        remaining: remaining,
        status: status
      });
    }
    
    return stockByCategory;
    
  } catch (error) {
    console.error('Error getting stock levels with reservations:', error);
    return {};
  }
}
// ==================== GET MATERIAL ORDERS ====================
function getMaterialOrders() {
  try {
    const ss = SpreadsheetApp.openById(SHEET_ID);
    const materialSheet = ss.getSheetByName('Material Order');
    
    if (!materialSheet) {
      console.error('Material Order sheet not found');
      return [];
    }
    
    const lastRow = materialSheet.getLastRow();
    if (lastRow < 2) return [];
    
    // Get data from columns A, B, C, D (Category, Item Name, Quantity, Status)
    const data = materialSheet.getRange('A2:D' + lastRow).getValues();
    const orders = [];
    
    for (let i = 0; i < data.length; i++) {
      const category = data[i][0];
      const itemName = data[i][1];
      let quantity = data[i][2];
      let status = data[i][3]; // Status from dropdown
      
      // Skip empty rows
      if (!category || !itemName) continue;
      
      // Ensure quantity is a number
      if (typeof quantity !== 'number') {
        quantity = parseInt(quantity) || 0;
      }
      
      // Only show items with quantity > 0
      if (quantity > 0) {
        // If status is empty, set default based on quantity
        if (!status || status === '') {
          if (quantity > 50) {
            status = 'Order placed';
          } else if (quantity > 10) {
            status = 'Shipping in progress';
          } else {
            status = 'Received';
          }
        }
        
        orders.push({
          category: category,
          itemName: itemName,
          quantity: quantity,
          status: status
        });
      }
    }
    
    // Sort by status priority: Order placed -> Shipping in progress -> Received
    const statusOrder = {
      'Order placed': 1,
      'Shipping in progress': 2,
      'Received': 3
    };
    
    orders.sort((a, b) => {
      const orderA = statusOrder[a.status] || 99;
      const orderB = statusOrder[b.status] || 99;
      if (orderA !== orderB) return orderA - orderB;
      return b.quantity - a.quantity;
    });
    
    return orders;
    
  } catch (error) {
    console.error('Error getting material orders:', error);
    return [];
  }
}

// ==================== GET FILTERED TRANSACTIONS ====================
function getFilteredTransactions(month, year) {
  try {
    const ss = SpreadsheetApp.openById(SHEET_ID);
    const sheet = ss.getSheetByName(TRANSACTIONS_SHEET);
    
    if (!sheet) return [];
    
    const lastRow = sheet.getLastRow();
    if (lastRow < 2) return [];
    
    const data = sheet.getRange('A2:J' + lastRow).getValues();
    const filteredData = [];

    data.forEach(row => {
      const timestamp = row[0];
      if (!timestamp) return;

      // Robust Date Parsing
      const dateObj = (timestamp instanceof Date) ? timestamp : new Date(timestamp);
      
      // Skip if the date is invalid
      if (isNaN(dateObj.getTime())) return;

      const tMonth = dateObj.getMonth();     // 0-11
      const tYear = dateObj.getFullYear();

      // Filtering Logic (-1 means "All")
      const monthMatch = (month == -1 || tMonth == month);
      const yearMatch = (year == -1 || tYear == year);

      if (monthMatch && yearMatch) {
        filteredData.push({
          timestamp: Utilities.formatDate(dateObj, Session.getScriptTimeZone(), "yyyy-MM-dd HH:mm"),
          category: row[1],
          itemName: row[2],
          type: row[3],
          quantity: row[4],
          prevStock: row[5],
          newStock: row[6],
          remark: row[7] || '',
          user: row[9] || 'System'
        });
      }
    });

    // Sort newest first
    return filteredData.reverse();
    
  } catch (error) {
    console.error('Error fetching transactions:', error);
    return [];
  }
}
