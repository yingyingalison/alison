// ==================== GET RECENT TRANSACTIONS (LIMITED) ====================
function getRecentTransactionsByMonth(month, limit = 200) {
  try {
    const ss = SpreadsheetApp.openById(SHEET_ID);
    const transactionsSheet = ss.getSheetByName(TRANSACTIONS_SHEET);
    
    if (!transactionsSheet) return [];
    
    const lastRow = transactionsSheet.getLastRow();
    if (lastRow < 2) return [];
    
    // Start from the most recent rows (bottom of sheet)
    const startRow = Math.max(2, lastRow - limit + 1);
    const numRows = lastRow - startRow + 1;
    const data = transactionsSheet.getRange(startRow, 1, numRows, 10).getValues();
    
    const transactions = [];
    
    for (let i = data.length - 1; i >= 0; i--) {
      const row = data[i];
      const timestamp = row[0];
      const category = row[1];
      const itemName = row[2];
      const transactionType = row[3];
      const quantity = row[4];
      const remark = row[7];
      const userName = row[9];
      
      if (!category || !itemName) continue;
      
      let transactionMonth = -1;
      if (timestamp instanceof Date) {
        transactionMonth = timestamp.getMonth();
      } else if (typeof timestamp === 'string' || typeof timestamp === 'number') {
        const dateObj = new Date(timestamp);
        if (!isNaN(dateObj.getTime())) {
          transactionMonth = dateObj.getMonth();
        }
      }
      
      if (month === -1 || transactionMonth === month) {
        transactions.push({
          timestamp: timestamp,
          category: category,
          itemName: itemName,
          transactionType: transactionType,
          quantity: quantity,
          remark: remark || '',
          userName: userName || 'Anonymous'
        });
      }
    }
    
    return transactions;
    
  } catch (error) {
    console.error('Error:', error);
    return [];
  }
}
