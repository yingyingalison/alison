// ==================== GET RESERVATIONS FOR AN ITEM ====================
function getReservations(category, itemName) {
  try {
    const ss = SpreadsheetApp.openById(SHEET_ID);
    let reservationsSheet = ss.getSheetByName('Reservations');
    
    if (!reservationsSheet) {
      reservationsSheet = ss.insertSheet('Reservations');
      const headers = ['Category', 'Item Name', 'Reserved By', 'Quantity', 'Date'];
      reservationsSheet.getRange(1, 1, 1, headers.length).setValues([headers]);
      reservationsSheet.getRange(1, 1, 1, headers.length).setFontWeight('bold');
      return { reservations: [], totalReserved: 0 };
    }
    
    const lastRow = reservationsSheet.getLastRow();
    if (lastRow < 2) return { reservations: [], totalReserved: 0 };
    
    const data = reservationsSheet.getRange('A2:E' + lastRow).getValues();
    const reservations = [];
    let totalReserved = 0;
    
    for (let i = 0; i < data.length; i++) {
      // Match by category AND item name
      const resCategory = data[i][0];
      const resItemName = data[i][1];
      
      if (resCategory === category && resItemName === itemName) {
        const qty = data[i][3];
        reservations.push({
          reservedBy: data[i][2],
          quantity: qty,
          date: data[i][4]
        });
        totalReserved += qty;
      }
    }
    
    // Sort reservations by date (newest first)
    reservations.sort((a, b) => new Date(b.date) - new Date(a.date));
    
    return {
      reservations: reservations,
      totalReserved: totalReserved
    };
    
  } catch (error) {
    console.error('Error getting reservations:', error);
    return { reservations: [], totalReserved: 0 };
  }
}

