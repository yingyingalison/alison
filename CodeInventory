// ==================== GET INVENTORY DATA ====================
function getInventoryData() {
  try {
    const ss = SpreadsheetApp.openById(SHEET_ID);
    const sheet = ss.getSheetByName(SHEET_NAME);
    
    if (!sheet) {
      console.error(`Sheet "${SHEET_NAME}" not found`);
      return { categories: [], itemsByCategory: {}, inventory: [] };
    }
    
    const lastRow = sheet.getLastRow();
    if (lastRow < 2) {
      return { categories: [], itemsByCategory: {}, inventory: [] };
    }
    
    const data = sheet.getRange('A2:C' + lastRow).getValues();
    const categories = new Set();
    const itemsByCategory = {};
    const inventory = [];
    
    for (let i = 0; i < data.length; i++) {
      const category = data[i][0];
      const itemName = data[i][1];
      const quantity = data[i][2];
      
      if (!category || !itemName) continue;
      
      categories.add(category);
      
      if (!itemsByCategory[category]) {
        itemsByCategory[category] = [];
      }
      
      itemsByCategory[category].push({
        name: itemName,
        quantity: typeof quantity === 'number' ? quantity : (parseInt(quantity) || 0)
      });
      
      inventory.push({
        category: category,
        itemName: itemName,
        quantity: typeof quantity === 'number' ? quantity : (parseInt(quantity) || 0)
      });
    }
    
    for (let cat in itemsByCategory) {
      itemsByCategory[cat].sort((a, b) => a.name.localeCompare(b.name));
    }
    
    return {
      categories: Array.from(categories).sort(),
      itemsByCategory: itemsByCategory,
      inventory: inventory
    };
    
  } catch (error) {
    console.error('Error getting inventory data:', error);
    return { categories: [], itemsByCategory: {}, inventory: [] };
  }
}

// ==================== GET CURRENT STOCK LEVELS ====================
function getStockLevels() {
  try {
    const ss = SpreadsheetApp.openById(SHEET_ID);
    const sheet = ss.getSheetByName(SHEET_NAME);
    
    if (!sheet) return {};
    
    const lastRow = sheet.getLastRow();
    if (lastRow < 2) return {};
    
    const data = sheet.getRange('A2:C' + lastRow).getValues();
    const stockByCategory = {};
    
    for (let i = 0; i < data.length; i++) {
      const category = data[i][0];
      const itemName = data[i][1];
      let quantity = data[i][2];
      
      if (!category || !itemName) continue;
      
      if (typeof quantity !== 'number') {
        quantity = parseInt(quantity) || 0;
      }
      
      if (!stockByCategory[category]) {
        stockByCategory[category] = [];
      }
      
      let status = 'Good';
      if (quantity === 0) {
        status = 'Out of Stock';
      } else if (quantity < 10) {
        status = 'Low Stock';
      } else if (quantity < 50) {
        status = 'Medium Stock';
      }
      
      stockByCategory[category].push({
        name: itemName,
        quantity: quantity,
        status: status
      });
    }
    
    return stockByCategory;
    
  } catch (error) {
    console.error('Error getting stock levels:', error);
    return {};
  }
}

// ==================== ADD TRANSACTION ====================
function addTransaction(data) {
  try {
    const ss = SpreadsheetApp.openById(SHEET_ID);
    const inventorySheet = ss.getSheetByName(SHEET_NAME);
    let transactionsSheet = ss.getSheetByName(TRANSACTIONS_SHEET);
    
    if (!transactionsSheet) {
      setup();
      transactionsSheet = ss.getSheetByName(TRANSACTIONS_SHEET);
    }
    
    const qty = parseInt(data.quantity);
    if (isNaN(qty) || qty <= 0) {
      throw new Error('Quantity must be a positive number');
    }
    
    const lastRow = inventorySheet.getLastRow();
    const inventoryData = inventorySheet.getRange('A2:C' + lastRow).getValues();
    
    let currentStock = 0;
    let rowIndex = -1;
    
    for (let i = 0; i < inventoryData.length; i++) {
      if (inventoryData[i][0] === data.category && inventoryData[i][1] === data.itemName) {
        currentStock = inventoryData[i][2];
        rowIndex = i + 2;
        break;
      }
    }
    
    if (rowIndex === -1) {
      throw new Error('Item not found in inventory');
    }
    
    let newStock = currentStock;
    if (data.inOut === 'In') {
      newStock = currentStock + qty;
    } else if (data.inOut === 'Out') {
      if (currentStock < qty) {
        throw new Error(`Insufficient stock! Current stock: ${currentStock}, Requested: ${qty}`);
      }
      newStock = currentStock - qty;
    }
    
    inventorySheet.getRange(rowIndex, 3).setValue(newStock);
    
    const timestamp = new Date();
    const user = data.userName || Session.getActiveUser().getEmail() || 'Anonymous';
    
    const transactionRow = [
      timestamp, data.category, data.itemName, data.inOut,
      qty, currentStock, newStock, data.remark || '',
      data.photoUrl || '', user
    ];
    
    transactionsSheet.appendRow(transactionRow);
    
    let alert = null;
    if (newStock < 10 && newStock > 0) {
      alert = `⚠️ Low stock alert: ${data.itemName} has only ${newStock} units left!`;
    } else if (newStock === 0) {
      alert = `⚠️ Out of stock alert: ${data.itemName} is now out of stock!`;
    }
    
    return {
      success: true,
      message: `✓ ${data.inOut}: ${qty} x ${data.itemName} (by ${user})`,
      newStock: newStock,
      alert: alert
    };
    
  } catch (error) {
    return {
      success: false,
      message: '✗ Error: ' + error.toString()
    };
  }
}

// ==================== UPLOAD PHOTO ====================
function uploadPhoto(base64Data, fileName) {
  try {
    const folderName = 'Inventory Photos';
    let folder = DriveApp.getFoldersByName(folderName);
    let targetFolder;
    
    if (folder.hasNext()) {
      targetFolder = folder.next();
    } else {
      targetFolder = DriveApp.createFolder(folderName);
    }
    
    const timestamp = new Date().getTime();
    const uniqueFileName = `${timestamp}_${fileName}`;
    
    const blob = Utilities.newBlob(Utilities.base64Decode(base64Data.split(',')[1]), 'image/jpeg', uniqueFileName);
    const file = targetFolder.createFile(blob);
    file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
    
    return file.getUrl();
    
  } catch (error) {
    console.error('Error uploading photo:', error);
    return '';
  }
}

